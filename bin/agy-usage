#!/usr/bin/env python3
"""Executable launcher for agy-usage."""

import os
import sys

# Ensure local package is importable whether run directly or via symlink
script_path = os.path.realpath(__file__)
repo_root = os.path.dirname(os.path.dirname(script_path))
if repo_root not in sys.path:
    sys.path.insert(0, repo_root)

from agy_usage.cli import main

if __name__ == "__main__":
    sys.exit(main())
